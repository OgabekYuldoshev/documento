NODE_ENV=development
PORT=3001
# Public origin of the web app (cookies/CORS/trusted origin). In dev the Vite proxy serves /api on this origin.
WEB_ORIGIN=http://localhost:3000
# Public base URL Better Auth uses to build links/cookies. Same as WEB_ORIGIN when proxied.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-min
DATABASE_URL=file:./data/app.db

# Generated PDF retention (days). Projects may override up to the max.
PDF_RETENTION_DAYS=1
PDF_RETENTION_MAX_DAYS=30

# File storage (assets, generated PDFs)
STORAGE_DIR=./data/storage
ASSET_MAX_MB=10
# Integrator image uploads (POST /v1/uploads): per file, lifetime, and active bytes per project
UPLOAD_MAX_MB=25
UPLOAD_TTL_MINUTES=60
UPLOAD_PROJECT_QUOTA_MB=1024

# Typst render (binary pinned to 0.15.1 in Docker; fonts dir holds Inter, Roboto, Noto, PT, Liberation...)
# Compile the sample data with Typst before publishing (turn off only in tests)
PUBLISH_DRY_RUN=on
TYPST_BIN=typst
FONTS_DIR=./fonts
RENDER_MEMORY_BUDGET_MB=2560
# Max jobs claimed at once (the memory budget still applies)
RENDER_CONCURRENCY=4
# Invalid /v1 API keys per IP per minute before 429
API_AUTH_MAX_FAILURES=20
# Idempotency-Key window (hours) and largest tRPC request body (MB)
IDEMPOTENCY_TTL_HOURS=24
TRPC_BODY_LIMIT_MB=12
# Pending (queued + processing) jobs per project; more is refused with 429
PROJECT_MAX_PENDING=100
# Editor previews one user may have in flight
PREVIEW_MAX_PER_USER=2
# A job claimed this many times without finishing is given up on (render_error)
JOB_MAX_ATTEMPTS=3
# Stuck `processing` jobs older than this (minutes) and not running here are recovered
JOB_STALE_MINUTES=30

# Sign-in throttle: this many failed attempts per email inside the window lock it (per IP: x4)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Audit log rows are deleted after this many days
AUDIT_RETENTION_DAYS=90
# Webhooks: delivery log retention, per-request timeout, attempts per delivery (max 6)
WEBHOOK_LOG_RETENTION_DAYS=30
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
# Dev only: let webhooks target localhost/private IPs (keep off in production: SSRF guard)
WEBHOOK_ALLOW_PRIVATE=off

# Seed (first superadmin)
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
