# Copy to .env (docker compose reads it automatically). Never commit the real file.

# Public domain: must resolve to this server, ports 80 and 443 open (Caddy issues the TLS certificate).
DOMAIN=docs.example.uz

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# First superadmin (created once, on first start). Change the password after the first login.
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# --- optional ---
# Memory the render queue may use at once, and the container ceiling (budget + ~1 GB headroom)
# RENDER_MEMORY_BUDGET_MB=2560
# API_MEM_LIMIT=4g
# PDF_RETENTION_DAYS=1
# AUDIT_RETENTION_DAYS=90
